# Copy to `.env` in the repo root. `build.bat` / `build.ps1` will create
# this file for you and fill in SECRET_KEY + DASHBOARD_PASSWORD_HASH on
# first run, then append any missing keys without touching your edits.

# ---------------------------------------------------------------------------
# Core / server
# ---------------------------------------------------------------------------

# Required: session signing (use a long random string in production).
SECRET_KEY=change-me-to-a-long-random-string

# Required: dashboard login. Either set DASHBOARD_PASSWORD (plain) to have
# the bootstrap hash it for you on first start, or set
# DASHBOARD_PASSWORD_HASH directly to a werkzeug scrypt hash.
# DASHBOARD_PASSWORD=your-strong-password
# DASHBOARD_PASSWORD_HASH=scrypt:32768:8:1$...

# Web server bind. Defaults: 0.0.0.0:5000.
HOST=0.0.0.0
PORT=5000

# Max upload size in bytes (default 200 MiB).
# MAX_CONTENT_LENGTH=209715200

# ---------------------------------------------------------------------------
# Paths (defaults: ./workspaces, ./tools, ./plugins.json under this repo)
# ---------------------------------------------------------------------------
# WORKSPACES_ROOT=C:\path\to\apk-wooper\workspaces
# TOOLS_ROOT=C:\path\to\apk-wooper\tools
# PLUGINS_CONFIG=C:\path\to\apk-wooper\plugins.json

# ---------------------------------------------------------------------------
# Java / decompile
# ---------------------------------------------------------------------------
# Optional: pin a specific JDK (full path to java.exe or java).
# JAVA_EXECUTABLE=C:\Program Files\Eclipse Adoptium\jdk-21.0.3.9-hotspot\bin\java.exe

# Auto-download missing JADX/Apktool into TOOLS_ROOT (default on).
AUTO_DOWNLOAD_TOOLS=true

# Cache local Java discovery (seconds). Force rescan via GET /api/java-runtimes?refresh=1.
JAVA_DISCOVERY_CACHE_SEC=600

# Minimum JDK major required by JADX (default 11).
# MIN_JAVA_MAJOR=11

# Run Apktool after JADX (smali + resources). Default on.
ENABLE_APKTOOL=true

# Per-job decompile budget in seconds (default 2700).
# DECOMPILE_TIMEOUT_SEC=2700

# Background workers used to run decompile jobs (default 2).
# JOB_POOL_WORKERS=2

# Max bytes the file viewer streams back to the dashboard (default 5 MiB).
# FILE_READ_MAX_BYTES=5242880

# ---------------------------------------------------------------------------
# Static analysis engine
# ---------------------------------------------------------------------------
ENABLE_ANALYSIS=true
ANALYSIS_AUTO_RUN=true
# ANALYSIS_WORKERS=4
# ANALYSIS_TIMEOUT_SEC=600
# ANALYSIS_TEXT_MAX_BYTES=5242880
# ANALYSIS_BINARY_MAX_BYTES=209715200

# Optional secret / native scanners. The Settings -> Analysis engine panel
# has one-click installers for each.
ENABLE_GITLEAKS=false
ENABLE_TRUFFLEHOG=false
ENABLE_RADARE2=false
ENABLE_APKID=false

# ---------------------------------------------------------------------------
# Plugins
# ---------------------------------------------------------------------------
ENABLE_PLUGINS=true

# Built-in MobSF plugin.
ENABLE_MOBSF=true
MOBSF_URL=http://localhost:8000
# MOBSF_API_KEY=
